# Postgres connection string used by the leads / orders / forge pipeline
# (drizzle-orm + node-postgres). The public pages fall back to the static
# plan catalog in src/lib/content.ts when this is unset, so the site still
# builds and renders without a database.
DATABASE_URL=postgres://user:password@host:5432/orr_technologies

# Public Bitcoin receiving address displayed at checkout. Optional — a
# placeholder is rendered when unset, and the binding address is always
# issued per-invoice by email.
NEXT_PUBLIC_BTC_ADDRESS=
